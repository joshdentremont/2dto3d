# Hostname Traefik should route to the app.
APP_HOST=2dto3d.example.com

# Bundled Traefik: uncomment to also start the Traefik container (docker-compose.traefik.yml),
# which creates the shared network itself. Leave it commented out if you already run Traefik
# on this server.
#COMPOSE_FILE=docker-compose.yml:docker-compose.traefik.yml

# Email for Let's Encrypt certificate notices (bundled Traefik only, optional).
ACME_EMAIL=

# Traefik names. With your own Traefik, these must match its setup; the bundled Traefik
# uses whatever is set here.
# Docker network shared by Traefik and the app:
TRAEFIK_NETWORK=traefik
# HTTPS entrypoint name:
TRAEFIK_ENTRYPOINT=websecure
# Certificate resolver name:
TRAEFIK_CERTRESOLVER=letsencrypt
