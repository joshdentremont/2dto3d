# Hostname Traefik should route to the app.
APP_HOST=logo3d.example.com

# Names from your existing Traefik setup. These are the common defaults.
# Docker network Traefik is attached to:
TRAEFIK_NETWORK=traefik
# HTTPS entrypoint name in Traefik's static config:
TRAEFIK_ENTRYPOINT=websecure
# Certificate resolver name in Traefik's static config:
TRAEFIK_CERTRESOLVER=letsencrypt
